# 카드 데이터는 이제 Postgres(도커 컨테이너)에 적재해서 쓰고, 로컬 JSON은
# backend/database/load_en_cards.py 적재용 임시 파일로만 사용한다.
# (backend/scraper/*_scraper.py 로 재생성 가능하므로 git에는 올리지 않는다)
backend/data/all_cards_en.json
backend/data/all_cards_en.partial.json
backend/data/all_cards_en.failed_ids.json

# 일본판 카드 데이터도 Postgres(cards_jp 테이블)로 이전했다.
# (backend/database/load_jp_cards.py 적재용 임시 파일로만 사용, git에는 안 올림)
backend/data/all_cards_jp.json
backend/data/all_cards_jp.partial.json
backend/data/all_cards_jp.failed.json

# 영문/일본 시리즈 정보도 Postgres(series_us, series_jp 테이블)로 이전했다.
# (backend/database/load_series_data.py 적재용 임시 파일로만 사용, git에는 안 올림)
backend/data/pokemon_series_us_info.json
backend/data/pokemon_series_jp_info.json

# 포켓몬 다국어 이름 매핑도 Postgres(pokemon_names 테이블)로 이전했다.
# (backend/database/load_pokemon_names.py 적재용 임시 파일로만 사용, git에는 안 올림)
backend/data/pokemon_names.json

